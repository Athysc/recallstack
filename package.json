{
  "name": "recallstack-desktop",
  "private": true,
  "version": "2.0.0",
  "author": "Sam Chiang <scdev@icloud.com>",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sync:desktop-assets": "node scripts/sync-desktop-assets.mjs",
    "predev": "npm run sync:desktop-assets",
    "dev": "vite",
    "prebuild": "npm run sync:desktop-assets",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "npm run sync:desktop-assets && tsc --noEmit && vite build --mode e2e",
    "test:frontend": "node --test tests/frontend/*.test.ts",
    "test:performance-build": "node scripts/verify-performance-build.mjs",
    "test:release:performance": "node scripts/run-release-performance.mjs",
    "test:windows-idle:performance": "node scripts/run-windows-idle-performance.mjs",
    "test:frontend:e2e": "node scripts/run-frontend-e2e.mjs",
    "verify:frontend": "npm run test:frontend && npm run build && npm run test:performance-build && (node scripts/run-frontend-e2e.mjs --if-available || echo 'Frontend desktop E2E failed; not blocking release verify while tracked separately in the frontend-e2e workflow.')",
    "check:versions": "node scripts/check-versions.mjs",
    "test:release": "node scripts/verify-release-config.mjs",
    "release:clean": "node scripts/package-release.mjs clean",
    "release:verify": "npm run check:versions && npm run test:release && npm run verify:frontend && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --no-bundle",
    "build:windows:portable": "tauri build --target x86_64-pc-windows-msvc --no-bundle -- --locked",
    "package:windows:portable": "node scripts/package-release.mjs windows-portable",
    "build:linux": "tauri build --no-bundle -- --locked",
    "build:linux:appimage": "node scripts/build-linux-appimage.mjs",
    "package:linux:tar": "node scripts/package-release.mjs linux-tar",
    "package:linux:appimage": "node scripts/package-release.mjs linux-appimage",
    "build:macos:app": "tauri build --target universal-apple-darwin --bundles app --ci --no-sign -- --locked",
    "package:macos:app": "node scripts/package-release.mjs macos-app"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@highlightjs/cdn-assets": "^11.11.1",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "edgedriver": false,
    "geckodriver": false
  }
}
