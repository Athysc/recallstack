{
  "name": "recallstack-desktop",
  "private": true,
  "version": "0.1.0",
  "author": "Sam Chiang <scdev@icloud.com>",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sync:desktop-assets": "node scripts/sync-desktop-assets.mjs",
    "predev": "npm run sync:desktop-assets",
    "dev": "vite",
    "prebuild": "npm run sync:desktop-assets",
    "build": "tsc --noEmit && vite build",
    "test:frontend": "node --test tests/frontend/*.test.ts",
    "test:frontend:parity": "node scripts/verify-frontend-parity.mjs",
    "verify:frontend": "npm run test:frontend && npm run test:frontend:parity && npm run build",
    "check:versions": "node scripts/check-versions.mjs",
    "test:release": "node scripts/verify-release-config.mjs",
    "release:clean": "node scripts/package-release.mjs clean",
    "release:verify": "npm run check:versions && npm run test:release && npm run verify:frontend && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --no-bundle",
    "build:windows:portable": "tauri build --target x86_64-pc-windows-msvc --no-bundle -- --locked",
    "package:windows:portable": "node scripts/package-release.mjs windows-portable",
    "build:linux": "tauri build --no-bundle -- --locked",
    "build:linux:appimage": "tauri build --bundles appimage --ci --no-sign -- --locked",
    "package:linux:tar": "node scripts/package-release.mjs linux-tar",
    "package:linux:appimage": "node scripts/package-release.mjs linux-appimage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@highlightjs/cdn-assets": "^11.11.1",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
