{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecallStack",
  "version": "0.1.0",
  "identifier": "com.recallstack.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "RecallStack",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 620
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown workspace",
    "longDescription": "RecallStack is a local-first Markdown workspace for notes, tasks, calendars, outputs, and searchable knowledge.",
    "copyright": "Copyright © 2026 Sam Chiang. All rights reserved.",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
